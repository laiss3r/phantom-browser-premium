{
  "name": "phantom-browser",
  "version": "0.2.0-dev.4",
  "private": true,
  "description": "Local-first Chromium profile manager",
  "author": "Phantom Browser contributors",
  "license": "MIT",
  "main": "app/main/bootstrap.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:integration": "playwright test tests/browser.integration.spec.ts tests/country-creation.integration.spec.ts",
    "build": "npm run typecheck && vite build && node scripts/bundle.mjs",
    "provision": "node scripts/provision.mjs",
    "dist:win": "node scripts/check-windows-package.mjs && npm run build && electron-builder --win nsis --publish never",
    "licenses": "node scripts/licenses.mjs",
    "test:desktop": "playwright test tests/desktop.integration.spec.ts",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "test:installed": "playwright test tests/installed.integration.spec.ts",
    "test:runtime": "vitest run tests/runtime.unit.test.ts",
    "start": "electron ."
  },
  "dependencies": {
    "jose": "6.2.13",
    "playwright": "1.64.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sql.js": "1.15.2",
    "tar": "7.5.22",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/sql.js": "1.4.9",
    "@vitejs/plugin-react": "6.0.1",
    "autoprefixer": "10.4.22",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yauzl": "3.4.0"
  },
  "build": {
    "appId": "org.phantombrowser.desktop",
    "productName": "Phantom Browser",
    "asar": true,
    "files": [
      "app/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "browser-runtime/chromium-1248",
        "to": "browser-runtime/chromium-1248"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "Phantom-Browser-Setup-${version}-${arch}.${ext}"
  },
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "type": "module"
}
